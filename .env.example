# Turso database (required in production / on Vercel).
#   turso db show <db> --url        -> libsql://<db>-<org>.turso.io
#   turso db tokens create <db>
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# Local development: leave TURSO_DATABASE_URL unset to use a local SQLite file (file:local.db),
# or point it at `turso dev` (http://127.0.0.1:8080).

# Optional: override the Open Food Facts endpoint.
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
