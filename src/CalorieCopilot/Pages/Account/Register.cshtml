@page
@model CalorieCopilot.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}
<div class="auth-card py-md-4">
    <div class="text-center mb-4">
        <img src="~/img/logo.svg" alt="" class="brand-logo" width="64" height="64" />
        <h1 class="h3 mt-3 mb-1">Create your account</h1>
        <p class="text-body-secondary">It takes less than a minute.</p>
    </div>
    <div class="card p-4">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="Input.TimeZone" data-browser-timezone />
            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" placeholder="Your name" autofocus />
                <label asp-for="Input.DisplayName"></label>
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</div>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2"><i class="bi bi-person-plus"></i> Create account</button>
        </form>
    </div>
    <p class="text-center mt-3 text-body-secondary">
        Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
    </p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
