@page
@model AnalyticsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Analytics";
    var u = Model.CurrentUser;
    var macroKcal = Model.AverageProtein * 4 + Model.AverageCarbs * 4 + Model.AverageFat * 9;
    string Share(double kcal) => macroKcal <= 0 ? "0" : (kcal / macroKcal * 100).ToString("0");
    var chartData = new
    {
        goal = u.DailyCalorieGoal,
        labels = Model.Daily.Select(d => Model.Days <= 7 ? d.Date.ToString("ddd") : d.Date.ToString("MMM d")).ToArray(),
        calories = Model.Daily.Select(d => Math.Round(d.Calories)).ToArray(),
        logged = Model.Daily.Select(d => d.EntryCount > 0).ToArray(),
        macros = new[] { Math.Round(Model.AverageProtein * 4), Math.Round(Model.AverageCarbs * 4), Math.Round(Model.AverageFat * 9) },
        macroGrams = new[] { Math.Round(Model.AverageProtein), Math.Round(Model.AverageCarbs), Math.Round(Model.AverageFat) },
        meals = Enum.GetValues<Meal>().Select(m => new { name = m.ToString(), kcal = Math.Round(Model.ByMeal.GetValueOrDefault(m)) }).ToArray(),
        weightUnit = Model.WeightUnit,
        weights = Model.Weights.Select(w => new { date = w.Date.ToString("MMM d"), value = Math.Round(Model.ToDisplayWeight(w.WeightKg), 1) }).ToArray(),
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Analytics</h1>
        <div class="text-body-secondary">@Model.From.ToString("MMM d") – @Model.To.ToString("MMM d, yyyy")</div>
    </div>
    <div class="btn-group" role="group" aria-label="Date range">
        @foreach (var r in AnalyticsModel.Ranges)
        {
            <a class="btn @(r == Model.Days ? "btn-success" : "btn-outline-success")" asp-route-days="@r" aria-current="@(r == Model.Days ? "true" : null)">@r days</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-tile p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2 text-body-secondary small"><span class="icon bg-success-subtle text-success"><i class="bi bi-fire"></i></span> Daily average</div>
            <div class="value">@Model.AverageCalories.ToString("N0") <span class="fs-6 fw-normal text-body-secondary">kcal</span></div>
            <div class="small text-body-secondary">Goal @u.DailyCalorieGoal.ToString("N0") kcal</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-tile p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2 text-body-secondary small"><span class="icon bg-primary-subtle text-primary"><i class="bi bi-bullseye"></i></span> On target</div>
            <div class="value">@Model.DaysOnTarget <span class="fs-6 fw-normal text-body-secondary">/ @Model.LoggedDays.Count days</span></div>
            <div class="small text-body-secondary">Within ±10% of goal</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-tile p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2 text-body-secondary small"><span class="icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-lightning-charge"></i></span> Streak</div>
            <div class="value">@Model.Streak <span class="fs-6 fw-normal text-body-secondary">day@(Model.Streak == 1 ? "" : "s")</span></div>
            <div class="small text-body-secondary">Consecutive days logged</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-tile p-3 h-100">
            <div class="d-flex align-items-center gap-2 mb-2 text-body-secondary small"><span class="icon bg-info-subtle text-info-emphasis"><i class="bi bi-speedometer2"></i></span> Weight change</div>
            @if (Model.WeightChange is { } change)
            {
                var display = Model.ToDisplayWeight(Math.Abs(change));
                <div class="value">
                    <i class="bi @(change < 0 ? "bi-arrow-down-right" : change > 0 ? "bi-arrow-up-right" : "bi-dash") fs-5"></i>
                    @display.ToString("0.0") <span class="fs-6 fw-normal text-body-secondary">@Model.WeightUnit</span>
                </div>
                <div class="small text-body-secondary">@(change < 0 ? "Lost" : change > 0 ? "Gained" : "No change") over @Model.Weights.Count weigh-ins</div>
            }
            else
            {
                <div class="value text-body-secondary">–</div>
                <div class="small text-body-secondary">Log at least two weigh-ins</div>
            }
        </div>
    </div>
</div>

@if (Model.LoggedDays.Count == 0)
{
    <div class="card p-5 text-center text-body-secondary mb-4">
        <i class="bi bi-bar-chart display-4 mb-2"></i>
        <p class="mb-3">No entries in this period yet. Charts appear once you start logging.</p>
        <div><a asp-page="/Diary" class="btn btn-success"><i class="bi bi-plus-lg"></i> Log your first meal</a></div>
    </div>
}

<div class="row g-4">
    <div class="col-12">
        <div class="card p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">Calories per day</h2>
                <div class="small text-body-secondary d-flex gap-3">
                    <span><span class="swatch" style="background:var(--viz-1)"></span>Eaten</span>
                    <span><span class="swatch" style="background:transparent;border:2px dashed var(--viz-goal);border-radius:2px"></span>Goal</span>
                </div>
            </div>
            <div class="chart-box"><canvas id="caloriesChart" aria-label="Bar chart of calories per day against your goal" role="img"></canvas></div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 p-md-4 h-100">
            <h2 class="h6 mb-3">Average macro split</h2>
            <div class="row align-items-center">
                <div class="col-6"><div class="chart-box sm"><canvas id="macroChart" aria-label="Average macronutrient calorie split" role="img"></canvas></div></div>
                <div class="col-6">
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><span class="swatch bg-protein"></span><strong>Protein</strong> @Share(Model.AverageProtein * 4)%<br /><span class="text-body-secondary ms-3">@Model.AverageProtein.ToString("0") g / day (goal @u.ProteinGoalG g)</span></li>
                        <li class="mb-2"><span class="swatch bg-carbs"></span><strong>Carbs</strong> @Share(Model.AverageCarbs * 4)%<br /><span class="text-body-secondary ms-3">@Model.AverageCarbs.ToString("0") g / day (goal @u.CarbsGoalG g)</span></li>
                        <li><span class="swatch bg-fat"></span><strong>Fat</strong> @Share(Model.AverageFat * 9)%<br /><span class="text-body-secondary ms-3">@Model.AverageFat.ToString("0") g / day (goal @u.FatGoalG g)</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 p-md-4 h-100">
            <h2 class="h6 mb-3">Calories by meal</h2>
            <div class="chart-box sm"><canvas id="mealChart" aria-label="Calories by meal" role="img"></canvas></div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card p-3 p-md-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h6 mb-0">Weight (@Model.WeightUnit)</h2>
                <form method="post" asp-page-handler="LogWeight" asp-route-days="@Model.Days" class="input-group input-group-sm" style="max-width: 240px">
                    <input asp-for="LogWeight" type="number" step="0.1" min="20" max="1000" class="form-control" placeholder="Today's weight" aria-label="Today's weight in @Model.WeightUnit" required />
                    <span class="input-group-text">@Model.WeightUnit</span>
                    <button class="btn btn-success" type="submit"><i class="bi bi-plus-lg"></i> Log</button>
                </form>
            </div>
            @if (Model.Weights.Count == 0)
            {
                <div class="text-body-secondary small py-5 text-center">No weigh-ins in this period. Log one above to start your trend line.</div>
            }
            else
            {
                <div class="chart-box sm"><canvas id="weightChart" aria-label="Weight trend" role="img"></canvas></div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-semibold py-3"><i class="bi bi-trophy"></i> Most logged foods</div>
            @if (Model.TopFoods.Count == 0)
            {
                <div class="card-body text-body-secondary small">Nothing logged yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th class="ps-3">Food</th><th class="text-end">Times</th><th class="text-end pe-3">kcal</th></tr></thead>
                        <tbody>
                            @foreach (var f in Model.TopFoods)
                            {
                                <tr>
                                    <td class="ps-3 text-truncate" style="max-width: 200px">@f.Name @if (f.Brand is not null) { <span class="text-body-secondary small">· @f.Brand</span> }</td>
                                    <td class="text-end">@f.TimesLogged</td>
                                    <td class="text-end pe-3">@f.TotalCalories.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<details class="mt-4">
    <summary class="text-body-secondary small">View daily data as a table</summary>
    <div class="card mt-2">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th class="ps-3">Date</th><th class="text-end">kcal</th><th class="text-end">Protein g</th><th class="text-end">Carbs g</th><th class="text-end pe-3">Fat g</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Daily.Reverse())
                    {
                        <tr class="@(d.EntryCount == 0 ? "text-body-secondary" : "")">
                            <td class="ps-3">@d.Date.ToString("ddd, MMM d")</td>
                            <td class="text-end">@d.Calories.ToString("N0")</td>
                            <td class="text-end">@d.ProteinG.ToString("0")</td>
                            <td class="text-end">@d.CarbsG.ToString("0")</td>
                            <td class="text-end pe-3">@d.FatG.ToString("0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</details>

<script type="application/json" id="analytics-data">@Html.Raw(JsonSerializer.Serialize(chartData, new JsonSerializerOptions(JsonSerializerDefaults.Web) { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
