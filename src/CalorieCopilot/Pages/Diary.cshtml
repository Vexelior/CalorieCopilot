@page
@model DiaryModel
@using System.Text.Json
@{
    ViewData["Title"] = "Diary";
    var u = Model.CurrentUser;
    var goal = Math.Max(1, u.DailyCalorieGoal);
    var consumed = Model.TotalCalories;
    var remaining = goal - consumed;
    const double circumference = 452.39;
    var dashOffset = circumference * (1 - Math.Min(1, consumed / goal));
    var dateLabel = Model.Date == Model.Today ? "Today"
        : Model.Date == Model.Today.AddDays(-1) ? "Yesterday"
        : Model.Date == Model.Today.AddDays(1) ? "Tomorrow"
        : Model.Date.ToString("dddd");
    var jsonOpts = new JsonSerializerOptions(JsonSerializerDefaults.Web) { Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() } };
    var mealIcons = new Dictionary<Meal, string>
    {
        [Meal.Breakfast] = "bi-sunrise", [Meal.Lunch] = "bi-sun", [Meal.Dinner] = "bi-moon-stars", [Meal.Snack] = "bi-apple",
    };
    string Pct(double value, int target) => Math.Min(100, target <= 0 ? 0 : value / target * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@dateLabel</h1>
        <div class="text-body-secondary">@Model.Date.ToString("MMMM d, yyyy")</div>
    </div>
    <form method="get" class="d-flex align-items-center gap-1" id="date-nav">
        <a class="btn btn-outline-secondary" asp-route-date="@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Previous day"><i class="bi bi-chevron-left"></i></a>
        <input type="date" name="date" class="form-control" style="width:auto" value="@Model.Date.ToString("yyyy-MM-dd")" aria-label="Choose date" onchange="this.form.submit()" />
        <a class="btn btn-outline-secondary" asp-route-date="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Next day"><i class="bi bi-chevron-right"></i></a>
        @if (Model.Date != Model.Today)
        {
            <a class="btn btn-outline-success" asp-page="/Diary">Today</a>
        }
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-4 mb-4">
            <div class="d-flex flex-column align-items-center">
                <div class="ring @(remaining < 0 ? "over" : "")" role="img" aria-label="@consumed.ToString("N0") of @goal.ToString("N0") kilocalories consumed">
                    <svg width="168" height="168" viewBox="0 0 168 168">
                        <circle class="track" cx="84" cy="84" r="72" fill="none" stroke-width="14" />
                        <circle class="value" cx="84" cy="84" r="72" fill="none" stroke-width="14"
                                stroke-dasharray="@circumference.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    </svg>
                    <div class="label">
                        <div class="big">@Math.Abs(remaining).ToString("N0")</div>
                        <div class="small text-body-secondary">@(remaining < 0 ? "kcal over" : "kcal left")</div>
                    </div>
                </div>
                <div class="d-flex justify-content-around w-100 mt-3 text-center">
                    <div><div class="fw-semibold">@goal.ToString("N0")</div><div class="small text-body-secondary">Goal</div></div>
                    <div><div class="fw-semibold">@consumed.ToString("N0")</div><div class="small text-body-secondary">Eaten</div></div>
                    <div><div class="fw-semibold">@Model.Entries.Count</div><div class="small text-body-secondary">Items</div></div>
                </div>
            </div>
            <hr />
            @foreach (var (label, cls, value, target) in new[]
            {
                ("Protein", "bg-protein", Model.TotalProtein, u.ProteinGoalG),
                ("Carbs", "bg-carbs", Model.TotalCarbs, u.CarbsGoalG),
                ("Fat", "bg-fat", Model.TotalFat, u.FatGoalG),
            })
            {
                <div class="small mb-1 d-flex justify-content-between">
                    <span><span class="swatch @cls"></span>@label</span>
                    <span class="text-body-secondary">@value.ToString("N0") / @target g</span>
                </div>
                <div class="macro-bar mb-3" role="progressbar" aria-label="@label" aria-valuenow="@Math.Round(value)" aria-valuemin="0" aria-valuemax="@target">
                    <span class="@cls" style="width:@Pct(value, target)%"></span>
                </div>
            }
        </div>

        <div class="d-grid gap-2 mb-4">
            <a class="btn btn-success btn-lg" asp-page="/Scan" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"><i class="bi bi-upc-scan"></i> Scan a barcode</a>
            <button type="button" class="btn btn-outline-success" data-add-meal="@Model.Input.Meal"><i class="bi bi-plus-lg"></i> Add food manually</button>
        </div>

        @if (Model.RecentFoods.Count > 0)
        {
            <div class="card">
                <div class="card-header fw-semibold"><i class="bi bi-clock-history"></i> Quick add from recent</div>
                <div class="list-group list-group-flush">
                    @foreach (var f in Model.RecentFoods)
                    {
                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                data-recent='@JsonSerializer.Serialize(f, jsonOpts)'>
                            <span class="text-truncate me-2">
                                @f.Name
                                @if (f.Brand is not null) { <span class="text-body-secondary small">· @f.Brand</span> }
                            </span>
                            <span class="badge text-bg-light border">@f.Calories.ToString("N0") kcal</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        @foreach (var meal in Enum.GetValues<Meal>())
        {
            var items = Model.EntriesFor(meal).ToList();
            var mealKcal = items.Sum(e => e.TotalCalories);
            <div class="card meal-card mb-3" id="meal-@meal.ToString().ToLowerInvariant()">
                <div class="card-header d-flex align-items-center justify-content-between py-3">
                    <div class="fw-semibold"><i class="bi @mealIcons[meal] me-1 text-success"></i> @meal</div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-body-secondary small">@mealKcal.ToString("N0") kcal</span>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@meal options">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item" type="button" data-add-meal="@meal"><i class="bi bi-plus-lg"></i> Add food</button></li>
                                <li><a class="dropdown-item" asp-page="/Scan" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-meal="@meal"><i class="bi bi-upc-scan"></i> Scan barcode</a></li>
                                <li>
                                    <form method="post" asp-page-handler="CopyPrevious">
                                        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="meal" value="@meal" />
                                        <button class="dropdown-item" type="submit"><i class="bi bi-copy"></i> Copy from yesterday</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                        <button class="btn btn-sm btn-success" type="button" data-add-meal="@meal" aria-label="Add food to @meal"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
                @if (items.Count == 0)
                {
                    <div class="card-body text-body-secondary small py-3">Nothing logged yet.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in items)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-medium text-truncate">
                                        @e.Name
                                        @if (e.Barcode is not null) { <i class="bi bi-upc text-body-secondary" title="Scanned"></i> }
                                    </div>
                                    <div class="small text-body-secondary text-truncate">
                                        @if (e.Brand is not null) { <text>@e.Brand · </text> }
                                        @e.Servings.ToString("0.##") × @(e.ServingDescription ?? "serving")
                                        · P @e.TotalProtein.ToString("0") g · C @e.TotalCarbs.ToString("0") g · F @e.TotalFat.ToString("0") g
                                    </div>
                                </div>
                                <div class="text-end fw-semibold text-nowrap">@e.TotalCalories.ToString("N0") <span class="small text-body-secondary fw-normal">kcal</span></div>
                                <div class="entry-actions d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Edit @e.Name"
                                            data-edit='@JsonSerializer.Serialize(new { e.Id, e.Meal, e.Name, e.Brand, e.ServingDescription, e.Servings, e.Calories, e.ProteinG, e.CarbsG, e.FatG }, jsonOpts)'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" data-confirm="Remove @e.Name from your diary?">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete @e.Name"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</div>

<!-- Add / edit entry modal -->
<div class="modal fade" id="entryModal" tabindex="-1" aria-labelledby="entryModalTitle" aria-hidden="true" data-show-on-load="@(Model.ShowModal ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <form method="post" class="modal-content" id="entryForm" asp-page-handler="@(Model.Input.Id is null ? "Add" : "Edit")"
              data-add-action="@Url.Page("/Diary", "Add")" data-edit-action="@Url.Page("/Diary", "Edit")">
            <div class="modal-header">
                <h2 class="modal-title h5" id="entryModalTitle">@(Model.Input.Id is null ? "Add food" : "Edit food")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="Input.Id" />
                <input type="hidden" name="Input.Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.Name" class="form-label">Food</label>
                        <input asp-for="Input.Name" class="form-control" placeholder="e.g. Greek yogurt" required maxlength="120" />
                    </div>
                    <div class="col-sm-7">
                        <label asp-for="Input.Brand" class="form-label">Brand <span class="text-body-secondary">(optional)</span></label>
                        <input asp-for="Input.Brand" class="form-control" maxlength="80" />
                    </div>
                    <div class="col-sm-5">
                        <label asp-for="Input.Meal" class="form-label">Meal</label>
                        <select asp-for="Input.Meal" class="form-select">
                            @foreach (var m in Enum.GetValues<Meal>())
                            {
                                <option value="@m" selected="@(m == Model.Input.Meal)">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-7">
                        <label asp-for="Input.ServingDescription" class="form-label"></label>
                        <input asp-for="Input.ServingDescription" class="form-control" placeholder="e.g. 1 cup, 100 g" maxlength="60" />
                    </div>
                    <div class="col-5">
                        <label asp-for="Input.Servings" class="form-label">Servings</label>
                        <input asp-for="Input.Servings" class="form-control" type="number" step="any" min="0.01" max="100" required />
                    </div>
                    <div class="col-12"><div class="small text-body-secondary">Nutrition per serving</div></div>
                    <div class="col-6 col-sm-3">
                        <label asp-for="Input.Calories" class="form-label small">kcal</label>
                        <input asp-for="Input.Calories" class="form-control" type="number" step="any" min="0" max="10000" required />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label asp-for="Input.ProteinG" class="form-label small"><span class="swatch bg-protein"></span>Protein g</label>
                        <input asp-for="Input.ProteinG" class="form-control" type="number" step="any" min="0" max="1000" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label asp-for="Input.CarbsG" class="form-label small"><span class="swatch bg-carbs"></span>Carbs g</label>
                        <input asp-for="Input.CarbsG" class="form-control" type="number" step="any" min="0" max="1000" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label asp-for="Input.FatG" class="form-label small"><span class="swatch bg-fat"></span>Fat g</label>
                        <input asp-for="Input.FatG" class="form-control" type="number" step="any" min="0" max="1000" />
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 py-2 small d-flex justify-content-between">
                            <span>Total for this entry</span><strong id="entryTotal">0 kcal</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success" id="entrySubmit"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/diary.js" asp-append-version="true"></script>
}
